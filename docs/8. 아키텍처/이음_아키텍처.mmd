      S1["일반 체인<br/>로그인(업체 코드+사번)<br/>URL 권한<br/>CSRF · 401/403 JSON 처리"]
      S2["/api/** 체인<br/>세션·CSRF 없음 · 로그인 없이 통과<br/>(단말기 키는 Service가 확인)"]
    end
    DS["DispatcherServlet"]
    IC["인터셉터<br/>계정 상태(비활성·역할 변경) · 만료 업체 읽기 전용"]
    subgraph LAYER["계층 (패키지: controller · service · dao · mapper · dto)"]
      C["Controller<br/>화면 주소 → JSP<br/>API → JSON(Jackson)"]
      SV["Service<br/>업무 규칙 · 데이터 권한<br/>@Transactional"]
      D["DAO"]
      M["Mapper<br/>(MyBatis XML)"]
      C --> SV --> D --> M
    end
    WS["WebSocket @ServerEndpoint<br/>/chat/room/{roomId} · /chat/updates"]
    FS["파일 저장 (FileStorage)<br/>형식 검사 · UUID 이름"]
    TOSSC["TossPaymentsClient<br/>(결제 승인 확인)"]
    MAIL["MailService<br/>JavaMailSender<br/>커밋 뒤 발송"]
  end

  subgraph DATA["저장소"]
    DB[("Oracle XE 21c<br/>모든 업체 같은 표 · company_id로 구분")]
    DISK[("서버 폴더 (WAR 밖)<br/>{루트}/{업체}/{모듈}/{UUID}")]
  end

