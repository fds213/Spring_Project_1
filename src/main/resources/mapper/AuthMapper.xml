<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ieum.gw.common.mapper.AuthMapper">

    <select id="getInfo" parameterType="String" resultType="com.ieum.gw.common.dto.AuthEmpDTO">
    SELECT empnum, pw, name, role, status
    FROM tblTestEmp
    WHERE empnum = #{empnum}
</select>
</mapper>
