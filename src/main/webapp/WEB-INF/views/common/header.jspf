<%-- tag 파일(layout.tag, site.tag)이 include 하므로 page 지시어 대신 tag 지시어를 쓴다 --%>
<%@ tag pageEncoding="UTF-8" %>
<%-- 그룹웨어·운영자 헤더. layout.tag 가 include 한다 (ctx, loginUser, isOps, isAdmin, readOnly 는 layout.tag 에서 정한 값,
     loginInfo 는 서버가 넣는 선택 값) --%>
<header class="app-header">
  <button class="icon-btn menu-btn" id="btnMenu" aria-label="메뉴 열기" aria-expanded="false" aria-controls="sidebar">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <a class="brand" href="${ctx}${isOps ? '/ops/company' : '/home'}">
    <img src="${ctx}/resources/img/logo-mark.png" alt="" class="brand-mark">
    <img src="${ctx}/resources/img/logo-wordmark.png" alt="IEUM" class="brand-word">
  </a>
  <%-- 업체 직원: 업체명, 이음 운영자: "이음 운영" --%>
  <span class="company"><c:out value="${isOps ? '이음 운영' : loginInfo.companyName}" /></span>

  <div class="header-right">
    <c:choose>
      <c:when test="${isOps}">
        <%-- 운영자 알림: 새 신청 수. 누르면 신청 현황으로 간다 --%>
        <a class="icon-btn" href="${ctx}/ops/application-status" aria-label="새 신청 알림">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3H4a4 4 0 0 0 2-3v-3a7 7 0 0 1 4-6"/><path d="M9 17v1a3 3 0 0 0 6 0v-1"/></svg>
          <span class="badge badge-dot" data-badge="application" hidden></span>
        </a>
      </c:when>
      <c:otherwise>
        <%-- 출퇴근은 지문 단말기가 기록한다. 화면은 받은 기록을 보여주기만 한다 --%>
        <span class="attend-time" title="지문 단말기 기록">
          <c:choose>
            <c:when test="${empty todayPunch}">출근 기록 없음</c:when>
            <c:when test="${empty todayPunch.outTime}">오늘 출근 <c:out value="${todayPunch.inTime}" /></c:when>
            <c:otherwise>출근 <c:out value="${todayPunch.inTime}" /> · 퇴근 <c:out value="${todayPunch.outTime}" /></c:otherwise>
          </c:choose>
        </span>
        <a class="icon-btn" href="${ctx}/notification/list" aria-label="알림">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3H4a4 4 0 0 0 2-3v-3a7 7 0 0 1 4-6"/><path d="M9 17v1a3 3 0 0 0 6 0v-1"/></svg>
          <span class="badge badge-dot" data-badge="notification" hidden></span>
        </a>
      </c:otherwise>
    </c:choose>

    <div class="user">
      <span class="avatar"><c:out value="${fn:substring(loginUser.name, 0, 1)}" /></span>
      <span class="user-text">
        <strong><c:out value="${loginUser.name}" /></strong>
        <small><c:choose><c:when test="${isOps}">이음 운영팀</c:when><c:when test="${not empty loginInfo.deptName}"><c:out value="${loginInfo.deptName}" /> · <c:out value="${loginInfo.rankName}" /></c:when><c:otherwise>사번 <c:out value="${loginUser.empnum}" /></c:otherwise></c:choose></small>
      </span>
    </div>
    <%-- 본인 비밀번호 변경 (요구분석서 v1.7 ACC-07, 읽기 전용 중에도 됨). 창은 layout.tag, 동작은 common.js. 운영자에게는 없다 --%>
    <c:if test="${not isOps}">
      <button class="btn btn-ghost" type="button" id="btnPwChange">비밀번호 변경</button>
    </c:if>
    <%-- 로그아웃은 CSRF 토큰을 실은 POST (Spring Security 기본 /logout) --%>
    <form class="logout-form" action="${ctx}/logout" method="post">
      <sec:csrfInput />
      <button class="btn" type="submit">로그아웃</button>
    </form>
  </div>
</header>

<%-- 체험 중이거나 체험이 끝난(읽기 전용) 업체만. 결제 버튼은 업체 관리자에게만 --%>
<c:if test="${not isOps and not empty companyBilling and companyBilling.status ne 'PAID'}">
  <c:set var="trialUrgent" value="${companyBilling.status eq 'TRIAL' and companyBilling.daysLeft le 3}" />
  <div class="trial-bar${trialUrgent ? ' is-urgent' : ''}${readOnly ? ' is-expired' : ''}" role="status">
    <span>
      <c:choose>
        <c:when test="${readOnly}">
          <strong>체험이 끝나 읽기 전용입니다 (<c:out value="${companyBilling.endDate}" /> 만료)</strong>
          <span class="trial-more">${isAdmin ? ' · 결제하면 바로 이어서 쓸 수 있습니다' : ' · 업체 관리자가 결제하면 바로 이어서 쓸 수 있습니다'}</span>
        </c:when>
        <c:when test="${companyBilling.daysLeft eq 0}">
          <strong>오늘 무료 체험이 끝납니다 (<c:out value="${companyBilling.endDate}" />)</strong>
          <span class="trial-more"> · 결제하지 않으면 체험이 끝난 뒤 읽기 전용으로 바뀝니다</span>
        </c:when>
        <c:otherwise>
          <strong>무료 체험 중 · D-${companyBilling.daysLeft} (<c:out value="${companyBilling.endDate}" /> 만료)</strong>
          <span class="trial-more">${trialUrgent ? ' · 결제하지 않으면 체험이 끝난 뒤 읽기 전용으로 바뀝니다' : ' · 결제하면 그날부터 유료로 이어서 씁니다'}</span>
        </c:otherwise>
      </c:choose>
    </span>
    <c:if test="${isAdmin}">
      <a class="btn btn-primary" href="${ctx}/subscription/billing">결제하기</a>
    </c:if>
  </div>
</c:if>
