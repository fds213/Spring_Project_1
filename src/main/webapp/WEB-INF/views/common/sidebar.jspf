<%-- tag 파일(layout.tag, site.tag)이 include 하므로 page 지시어 대신 tag 지시어를 쓴다 --%>
<%@ tag pageEncoding="UTF-8" %>
<%--
  사이드 메뉴. layout.tag 가 include 한다. 역할로 보일지 정하는 것은 sec:authorize (실제 접근은 Security URL 규칙과 Service가 막는다).
  두 단이다: 왼쪽 아이콘 줄(nav-rail)은 메뉴 묶음(홈·전자결재·IT 서비스 …), 오른쪽 칸(nav-panel)은 고른 묶음의 메뉴만 보인다.
  처음에는 지금 화면(menu 키)이 속한 묶음을 서버가 열어 둔다. 아이콘을 누르면 common.js 가 오른쪽 칸만 바꾼다(페이지 이동 없음).
  주소는 /<모듈>/<기능>, 관리 화면은 /<모듈>/admin/<기능> (AGENTS.md). Security 는 /*/admin/** 를 ADMIN 만 통과시키므로,
  인사 담당(HR)·IT 담당이 여는 관리 화면은 그 위에 규칙이 따로 있어야 한다(security-context.xml).
  역할은 ROLE_EMP / ROLE_IT / ROLE_HR / ROLE_ADMIN / ROLE_OPS(이음 운영자) 중 한 사람에 하나다.
  이용 결제는 subscription 모듈의 업무 화면 주소 /subscription/billing 이다(기능명세서 1.1: 관리 화면 주소 밖, 서버가 요청마다 권한 확인).
  업체 관리자는 IT·인사 담당이 없는 업체도 쓸 수 있게 자산 관리·근태·연차 관리·휴일 관리도 본다(기능명세서 1.1).
  메뉴는 기능명세서 1.1과 요구분석서 3장 '이번 구현 범위'(11/13 마감)를 따른다. 이번 제외라 뺀 메뉴:
  운영자 증설 승인(CAP-01)·운영 데이터(범위 표의 OPS-01은 업체·문의 목록만),
  근무 > 승인(명세 메뉴에 없음, 휴가 결재는 전자결재). 익명 게시판·자료실은 요구분석서 3장 '추가 구현 범위'로 소통 묶음에 둔다. 운영자는 운영 메뉴와 이음 운영 업체의 직원 기본 메뉴를 함께 본다.
  업체 관리의 직급 관리는 공통 코드 시트 기준이다(명세 1.1은 역할 관리, 팀 확인 필요). 새 메뉴 주소는 제안이고, 화면이 생길 때 담당이 확정한다.
  담당이 이미 만든 화면은 그 Controller 주소를 쓴다(채팅 /chat/rooms).
  가입 승인은 업체 관리자와 부서장(loginInfo.headDeptName: 내가 부서장인 부서, 아니면 null)이 본다. 부서장이 직원·IT 담당이어도
  인사 묶음이 보이고, 그 안에는 가입 승인만 있다. 부서장이 자기 부서 요청만 승인하는 것은 서버(JoinService)가 막는다.
  배지 숫자는 data-badge 칸을 common.js 가 GET /badges 로 15초마다 채운다. 아이콘 줄의 배지도 같은 이름이라 같이 채워진다.
--%>
<%-- 지금 화면의 menu 키 → 묶음. 묶음 이름은 menu 키 앞부분을 따른다 --%>
<c:choose>
  <c:when test="${fn:startsWith(menu, 'ops-')}"><c:set var="navCat" value="ops" /></c:when>
  <c:when test="${fn:startsWith(menu, 'approval-')}"><c:set var="navCat" value="approval" /></c:when>
  <c:when test="${fn:startsWith(menu, 'ticket-') or fn:startsWith(menu, 'asset-') or fn:startsWith(menu, 'support-')}"><c:set var="navCat" value="it" /></c:when>
  <c:when test="${menu eq 'attendance' or menu eq 'leave' or menu eq 'schedule' or menu eq 'attendance-device'}"><c:set var="navCat" value="work" /></c:when>
  <c:when test="${menu eq 'chat' or fn:startsWith(menu, 'board-') or menu eq 'location'}"><c:set var="navCat" value="talk" /></c:when>
  <c:when test="${menu eq 'org'}"><c:set var="navCat" value="company" /></c:when>
  <c:when test="${fn:startsWith(menu, 'hr-')}"><c:set var="navCat" value="hr" /></c:when>
  <c:when test="${fn:startsWith(menu, 'admin-')}"><c:set var="navCat" value="admin" /></c:when>
  <c:otherwise><c:set var="navCat" value="home" /></c:otherwise>
</c:choose>
<%-- 인사 묶음: 인사 담당·업체 관리자는 전부, 부서장은 가입 승인만 --%>
<sec:authorize access="hasAnyRole('HR','ADMIN')" var="canHr" />
<c:set var="canJoin" value="${isAdmin or not empty loginInfo.headDeptName}" />
<nav class="sidebar" id="sidebar" aria-label="메뉴">
  <%-- 왼쪽 아이콘 줄: 누르면 오른쪽 칸에 그 묶음의 메뉴가 보인다 --%>
  <div class="nav-rail">
    <c:if test="${isOps}">
      <button type="button" class="rail-item${navCat eq 'ops' ? ' on' : ''}" data-cat="ops" aria-controls="navCat-ops" aria-pressed="${navCat eq 'ops'}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>운영</span><span class="badge rail-badge" data-badge="application" hidden></span>
      </button>
    </c:if>
    <button type="button" class="rail-item${navCat eq 'home' ? ' on' : ''}" data-cat="home" aria-controls="navCat-home" aria-pressed="${navCat eq 'home'}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/></svg>
      <span>홈</span>
    </button>
    <button type="button" class="rail-item${navCat eq 'approval' ? ' on' : ''}" data-cat="approval" aria-controls="navCat-approval" aria-pressed="${navCat eq 'approval'}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="m8.5 16.5 1-3 4.5-4.5 2 2-4.5 4.5z"/></svg>
      <span>결재</span><span class="badge rail-badge" data-badge="approval" hidden></span>
    </button>
    <button type="button" class="rail-item${navCat eq 'it' ? ' on' : ''}" data-cat="it" aria-controls="navCat-it" aria-pressed="${navCat eq 'it'}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      <span>IT 서비스</span>
    </button>
    <button type="button" class="rail-item${navCat eq 'work' ? ' on' : ''}" data-cat="work" aria-controls="navCat-work" aria-pressed="${navCat eq 'work'}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <span>근무</span>
    </button>
    <button type="button" class="rail-item${navCat eq 'talk' ? ' on' : ''}" data-cat="talk" aria-controls="navCat-talk" aria-pressed="${navCat eq 'talk'}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
      <span>소통</span><span class="badge rail-badge" data-badge="chat" hidden></span>
    </button>
    <button type="button" class="rail-item${navCat eq 'company' ? ' on' : ''}" data-cat="company" aria-controls="navCat-company" aria-pressed="${navCat eq 'company'}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-2.5h12V16"/></svg>
      <span>회사</span>
    </button>
    <c:if test="${canHr or canJoin}">
      <button type="button" class="rail-item${navCat eq 'hr' ? ' on' : ''}" data-cat="hr" aria-controls="navCat-hr" aria-pressed="${navCat eq 'hr'}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6"/></svg>
        <span>인사</span><c:if test="${canJoin}"><span class="badge rail-badge" data-badge="join" hidden></span></c:if>
      </button>
    </c:if>
    <sec:authorize access="hasRole('ADMIN')">
      <button type="button" class="rail-item${navCat eq 'admin' ? ' on' : ''}" data-cat="admin" aria-controls="navCat-admin" aria-pressed="${navCat eq 'admin'}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/><path d="M16 9h2a2 2 0 0 1 2 2v10"/><path d="M8 7h4M8 11h4M8 15h4M3 21h18"/></svg>
        <span>업체 관리</span>
      </button>
    </sec:authorize>
  </div>

  <%-- 오른쪽 칸: 묶음마다 하나, 고른 묶음만 보인다 --%>
  <div class="nav-panel">
    <%-- 업체명: 폰에서는 머리글에 자리가 없어 머리글 대신 여기(메뉴를 열면 맨 위)에 보인다. PC에서는 숨긴다(머리글에 있다) --%>
    <c:set var="navCompany" value="${isOps ? '이음 운영' : loginInfo.companyName}" />
    <c:if test="${not empty navCompany}"><p class="nav-company"><c:out value="${navCompany}" /></p></c:if>
    <c:if test="${isOps}">
      <%-- 이음 운영자 메뉴 (주소 /ops/...). 운영자는 아래 직원 기본 메뉴도 함께 본다 --%>
      <div class="nav-cat" id="navCat-ops" data-cat="ops"${navCat eq 'ops' ? '' : ' hidden'}>
        <p class="nav-title">이음 운영</p>
        <p class="nav-group">업체</p>
        <ui:nav key="ops-company" path="/ops/company" current="${menu}">업체 관리</ui:nav>
        <%-- 업체 계정(/ops/account-company): 화면이 아직 없다. 만들면 다시 연다 --%>
        <p class="nav-group">신청</p>
        <ui:nav key="ops-application-status" path="/ops/application-status" current="${menu}">신청 현황 <span class="badge" data-badge="application" hidden></span></ui:nav>
        <p class="nav-group">문의</p>
        <ui:nav key="ops-inquiry-guest" path="/ops/inquiry-guest" current="${menu}">비회원 접수 <span class="badge" data-badge="inquiryGuest" hidden></span></ui:nav>
        <ui:nav key="ops-inquiry-member" path="/ops/inquiry-member" current="${menu}">회원 접수</ui:nav>
      </div>
    </c:if>

    <%-- 업체 직원 기본 메뉴 (운영자도 본다). 관리 묶음은 역할로 가린다 --%>
    <div class="nav-cat" id="navCat-home" data-cat="home"${navCat eq 'home' ? '' : ' hidden'}>
      <p class="nav-title">홈</p>
      <ui:nav key="home" path="/home" current="${menu}">메인</ui:nav>
      <ui:nav key="notice" path="/board/notice" current="${menu}">공지사항</ui:nav>
    </div>
    <div class="nav-cat" id="navCat-approval" data-cat="approval"${navCat eq 'approval' ? '' : ' hidden'}>
      <p class="nav-title">전자결재</p>
      <ui:nav key="approval-write" path="/approval/write" current="${menu}" write="true">기안 작성</ui:nav>
      <ui:nav key="approval-box" path="/approval/list" current="${menu}">결재함 <span class="badge" data-badge="approval" hidden></span></ui:nav>
    </div>
    <div class="nav-cat" id="navCat-it" data-cat="it"${navCat eq 'it' ? '' : ' hidden'}>
      <p class="nav-title">IT 서비스</p>
      <ui:nav key="ticket-new" path="/ticket/new" current="${menu}" write="true">장애·문의 접수</ui:nav>
      <ui:nav key="ticket-mine" path="/ticket/mine" current="${menu}">내 티켓</ui:nav>
      <ui:nav key="asset-mine" path="/asset/mine" current="${menu}">내 장비</ui:nav>
      <ui:nav key="support-inquiry" path="/support/inquiry" current="${menu}">이음 장애 문의</ui:nav>
      <sec:authorize access="hasAnyRole('IT','ADMIN')">
        <p class="nav-group">관리</p>
        <ui:nav key="ticket-all" path="/ticket/admin/list" current="${menu}">티켓 처리</ui:nav>
        <ui:nav key="asset-all" path="/asset/admin/list" current="${menu}">자산 관리</ui:nav>
      </sec:authorize>
    </div>
    <div class="nav-cat" id="navCat-work" data-cat="work"${navCat eq 'work' ? '' : ' hidden'}>
      <p class="nav-title">근무</p>
      <ui:nav key="attendance" path="/attendance/my" current="${menu}">근태</ui:nav>
      <ui:nav key="leave" path="/attendance/leave" current="${menu}">연차</ui:nav>
      <ui:nav key="schedule" path="/schedule/calendar" current="${menu}">일정</ui:nav>
      <%-- 업체 관리자·인사 담당: 근태 단말기 화면(키 발급·직원 연결, 지문 시뮬레이터 열기 버튼이 그 화면에 있다).
           그 밖의 직원: 지문 시뮬레이터를 새 탭으로 (요구분석서 3.10: 직원은 그룹웨어의 링크로 시뮬레이터를 연다).
           근태 단말기 주소는 /attendance/admin/** 라 Security 도 같은 역할만 통과시킨다 --%>
      <sec:authorize access="hasAnyRole('HR','ADMIN')" var="canManageDevice" />
      <c:choose>
        <c:when test="${canManageDevice}">
          <ui:nav key="attendance-device" path="/attendance/admin/device" current="${menu}">근태 단말기</ui:nav>
        </c:when>
        <c:otherwise>
          <a href="${ctx}/attendance/simulator" class="nav-item" target="_blank" rel="noopener" title="새 탭에서 열립니다">지문 시뮬레이터</a>
        </c:otherwise>
      </c:choose>
    </div>
    <div class="nav-cat" id="navCat-talk" data-cat="talk"${navCat eq 'talk' ? '' : ' hidden'}>
      <p class="nav-title">소통</p>
      <%-- 채팅 목록은 채팅 담당의 ChatController 주소를 따른다 (/chat/rooms) --%>
      <ui:nav key="chat" path="/chat/rooms" current="${menu}">채팅 <span class="badge" data-badge="chat" hidden></span></ui:nav>
      <ui:nav key="board-dept" path="/board/dept" current="${menu}">부서 게시판</ui:nav>
      <ui:nav key="board-anon" path="/board/anon" current="${menu}">익명 게시판</ui:nav>
      <ui:nav key="board-library" path="/board/library" current="${menu}">자료실</ui:nav>
      <ui:nav key="location" path="/location/map" current="${menu}">지도</ui:nav>
    </div>
    <div class="nav-cat" id="navCat-company" data-cat="company"${navCat eq 'company' ? '' : ' hidden'}>
      <p class="nav-title">회사</p>
      <ui:nav key="org" path="/employee/org" current="${menu}">조직도</ui:nav>
    </div>
    <c:if test="${canHr or canJoin}">
      <div class="nav-cat" id="navCat-hr" data-cat="hr"${navCat eq 'hr' ? '' : ' hidden'}>
        <p class="nav-title">인사 관리</p>
        <c:if test="${canHr}"><ui:nav key="hr-employee" path="/employee/admin/list" current="${menu}">사원 관리</ui:nav></c:if>
        <c:if test="${canJoin}"><ui:nav key="hr-join" path="/employee/join" current="${menu}">가입 승인 <span class="badge" data-badge="join" hidden></span></ui:nav></c:if>
        <c:if test="${canHr}">
          <ui:nav key="hr-attendance" path="/attendance/admin/list" current="${menu}">근태·연차 관리</ui:nav>
          <ui:nav key="hr-holiday" path="/attendance/admin/holiday" current="${menu}">휴일 관리</ui:nav>
        </c:if>
      </div>
    </c:if>
    <sec:authorize access="hasRole('ADMIN')">
      <%-- 업체 관리: 부서·직급은 employee 모듈의 관리 화면, 이용 결제는 subscription 모듈의 업무 화면 --%>
      <div class="nav-cat" id="navCat-admin" data-cat="admin"${navCat eq 'admin' ? '' : ' hidden'}>
        <p class="nav-title">업체 관리</p>
        <ui:nav key="admin-dept" path="/employee/admin/dept" current="${menu}">부서 관리</ui:nav>
        <ui:nav key="admin-rank" path="/employee/admin/rank" current="${menu}">직급 관리</ui:nav>
        <ui:nav key="admin-billing" path="/subscription/billing" current="${menu}">이용 결제</ui:nav>
      </div>
    </sec:authorize>
  </div>
</nav>
