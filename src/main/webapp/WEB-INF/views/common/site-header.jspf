<%-- tag 파일(layout.tag, site.tag)이 include 하므로 page 지시어 대신 tag 지시어를 쓴다 --%>
<%@ tag pageEncoding="UTF-8" %>
<%--
  홈페이지형 헤더. site.tag 가 include 한다 (ctx, current, cta 는 site.tag 의 값).
  그룹웨어는 설치한 앱으로 들어가므로 로그인 링크 대신 다운로드(앱 설치) 버튼을 둔다.
  내려가면 그림자(is-scrolled), 소개 페이지에서는 보고 있는 구역의 메뉴를 강조(is-active)한다: site.js
--%>
<header class="site-header" id="siteHeader">
  <div class="wrap">
    <a class="brand" href="${ctx}/">
      <img src="${ctx}/resources/img/logo-mark.svg" alt="" class="brand-mark">
      <img src="${ctx}/resources/img/logo-wordmark.svg" alt="IEUM" class="brand-word">
    </a>
    <nav class="site-nav" id="siteNav">
      <a href="${ctx}/#intro">서비스 소개</a>
      <a href="${ctx}/#features">기능</a>
      <a href="${ctx}/#process">도입 절차</a>
      <a href="${ctx}/#pricing">가격</a>
      <a href="${ctx}/inquiry"${current eq 'inquiry' ? ' aria-current="page"' : ''}>도입 문의</a>
    </nav>
    <div class="site-actions">
      <%-- 체험 신청 페이지만 cta="false" (자기 자신으로 가는 버튼이라) --%>
      <c:if test="${cta ne false}">
        <a class="btn btn-primary" href="${ctx}/trial">무료 체험</a>
      </c:if>
      <%-- 다운로드: IEUM 앱(PWA)을 설치한다. 그룹웨어는 설치한 앱에서 쓴다 --%>
      <button type="button" class="btn btn-download" data-download aria-label="IEUM 앱 다운로드">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
        <span>다운로드</span>
      </button>
      <button class="icon-btn site-menu-btn" id="btnSiteMenu" aria-label="메뉴 열기" aria-expanded="false" aria-controls="siteNav">
        <svg class="menu-ic-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="menu-ic-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
</header>
